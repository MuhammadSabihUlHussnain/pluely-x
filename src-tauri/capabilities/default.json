{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Overlay and dashboard windows",
  "windows": ["main", "dashboard"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "sql:default",
    "sql:allow-execute",
    "opener:default"
  ]
}
